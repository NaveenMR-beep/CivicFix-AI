# CivicFix AI Configuration — Environment Template
PROJECT_NAME="CivicFix AI"

# Database Configuration:
# Default development fallback uses SQLite:
DATABASE_URL="sqlite:///./civicfix.db"

# For PostgreSQL (Production / Local PostgreSQL service):
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/civicfix"

# JWT Authentication
SECRET_KEY="civicfix-ai-super-secret-key-for-jwt-signing-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Upload Configuration
MAX_IMAGE_SIZE_MB=5
UPLOAD_FOLDER="uploads"

# Duplicate Detection Radius
DUPLICATE_DISTANCE_METERS=150.0

# Priority Scoring Weights
WEIGHT_SEVERITY=0.40
WEIGHT_SAFETY_RISK=0.35
WEIGHT_COMMUNITY_IMPACT=0.25
